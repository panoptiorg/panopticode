# Copy to deploy/.env (compose) and/or export in your shell (scripts).
# Host port Postgres is published on (container port is always 5432).
PC_PG_PORT=5433
# Connection URL the analyzer and scripts use.
PC_PG_URL=postgres://panopticode:panopticode@localhost:5433/panopticode
# FS summary store dir (content-addressed blobs; warms `impact` cache).
PC_STORE=output/store
